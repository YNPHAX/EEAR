rules_version = '2';
// Regras do Cloud Firestore do Missão EEAR (Firebase Authentication + Firestore). Privilégio mínimo:
// - cada aluno só lê (get), cria, atualiza e apaga o próprio documento alunos/{uid}, onde uid é o do login (request.auth.uid);
// - ninguém lista a coleção alunos (nem o próprio aluno: o app só lê o documento dele pelo id);
// - qualquer outro caminho é recusado (regra final).
// O documento guarda só v (versão do formato), dados (o progresso, em texto), t (quando o aparelho gravou) e
// atualizado (hora do servidor). dados pode conter cfg.nome, usado no certificado; não é um campo anônimo.
// As regras validam o envelope, não o JSON dentro de dados. Um app antigo (v menor) não grava por cima
// de um documento de versão mais nova. Estas regras não são as do banco de dados do Claude (web/regras-claude.json):
// lá a autorização é por nível de compartilhamento do artifact; aqui, pelo uid do Firebase Authentication.
// Testado com o emulador oficial em testes/firebase-emulador.test.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function documentoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'dados', 't', 'atualizado'])
        && d.keys().hasAll(['v', 'dados', 't', 'atualizado'])
        && d.v is int && d.v >= 1
        && d.dados is string && d.dados.size() < 900000
        && d.t is number
        && d.atualizado == request.time;
    }
    match /alunos/{uid} {
      allow get: if dono(uid) && !exists(/databases/$(database)/documents/contasExcluidas/$(uid));
      allow list: if false;
      allow create: if dono(uid) && !exists(/databases/$(database)/documents/contasExcluidas/$(uid)) && documentoValido();
      allow update: if dono(uid) && !exists(/databases/$(database)/documents/contasExcluidas/$(uid)) && documentoValido()
        && (!('v' in resource.data) || request.resource.data.v >= resource.data.v);
      allow delete: if dono(uid);
    }
    // Tombstone mínimo: bloqueia escritores com tokens antigos. Imutável; não contém nome ou progresso.
    match /contasExcluidas/{uid} {
      allow get: if dono(uid);
      allow list, update, delete: if false;
      allow create: if dono(uid) && request.resource.data.keys().hasOnly(['v', 'excluida'])
        && request.resource.data.keys().hasAll(['v', 'excluida']) && request.resource.data.v == 1
        && request.resource.data.excluida == request.time;
    }
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
