rules_version = '2';
// Uma conta INPHAX vale para todos os cursos. Cada aluno lê e grava só o próprio perfil
// (documento alunos/{uid}) e o próprio progresso em cada curso (alunos/{uid}/cursos/{curso}).
service cloud.firestore {
  match /databases/{database}/documents {
    match /alunos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'atualizado']);
      match /cursos/{curso} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.dados is string
          && request.resource.data.dados.size() < 900000;
      }
    }
  }
}
